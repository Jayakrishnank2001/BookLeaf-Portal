# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Database
MONGODB_URI=mongodb://localhost:27017/bookleaf

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# AI (optional: app still works without it, drafts/classification degrade gracefully)
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=10000

# Seed script demo passwords (optional overrides)
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123
